# Copier vers /etc/cantine-guard/env (chmod 600, root ou user dédié)

GUARD_BASE_URL=https://cantine360.vercel.app
CANTINE_GUARD_SECRET=change-me-min-16-chars

# Optionnel — alertes uniquement à l’ouverture / clôture d’incident
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

GUARD_STATE_PATH=/var/lib/cantine-guard/last-state.json
GUARD_REPORT_PATH=/var/lib/cantine-guard/last-report.json
